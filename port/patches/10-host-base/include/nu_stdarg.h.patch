--- a/include/nu_stdarg.h
+++ b/include/nu_stdarg.h
@@ -1,6 +1,12 @@
 #ifndef NU_STDARG_H
 #define NU_STDARG_H
 
+#ifdef NW_HOST
+
+#include <stdarg.h>
+
+#else
+
 /* gcc 2.95 va-mips.h (EABI): va_start backs up over the unused named-argument
  * slots. Slots are 8 bytes; va_arg handles integer arguments only. */
 typedef char *va_list;
@@ -11,4 +17,6 @@ typedef char *va_list;
 #define va_arg(ap, type) (*(type *)(((ap) += 8) - 8))
 #define va_end(ap) ((ap) = (va_list)0)
 
+#endif
+
 #endif /* NU_STDARG_H */
