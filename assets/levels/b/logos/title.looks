;; TITLE.GHG's materials and the recipe each wears.
slot        0       crash
slot        1       bandicoot
slot        2       subtitle-front
slot        3       subtitle-back
slot        4       water
slot        5       ring
slot        6       blue-arc
slot        7       button
slot        8       panel
slot        9       tubes
