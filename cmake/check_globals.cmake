# Fails when two decomp objects define the same global, as the link would (ctest decomp-globals):
string(REPLACE "|" ";" objects "${OBJECTS}")
execute_process(COMMAND ${NM} --defined-only --extern-only --format=posix ${objects}
  OUTPUT_VARIABLE out RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "${NM} failed")
endif()
string(REPLACE "\r" "" out "${out}")
string(REPLACE "\n" ";" lines "${out}")

# "<name> <type> ..." per symbol; weak symbols, MinGW's .refptr COMDATs and ASan's per-object symbols may repeat.
set(names)
foreach(line IN LISTS lines)
  if(NOT line MATCHES "^([^ ]+) ([A-Za-z]) ")
    continue()
  endif()
  set(name ${CMAKE_MATCH_1})
  set(type ${CMAKE_MATCH_2})
  if(NOT type MATCHES "^[WwVv]$" AND NOT name MATCHES "^\\.refptr\\." AND NOT name MATCHES "^_+asan_")
    list(APPEND names ${name})
  endif()
endforeach()

list(SORT names)
set(previous "")
set(duplicates)
foreach(name IN LISTS names)
  if(name STREQUAL previous)
    list(APPEND duplicates ${name})
  endif()
  set(previous ${name})
endforeach()
list(REMOVE_DUPLICATES duplicates)
list(LENGTH names count)
if(duplicates)
  list(JOIN duplicates ", " duplicates)
  message(FATAL_ERROR "globals defined by several decomp objects: ${duplicates}")
endif()
message(STATUS "${count} globals, none defined twice")
