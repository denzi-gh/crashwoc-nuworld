file(REMOVE_RECURSE ${DIR}/crashes)
execute_process(COMMAND ${EXE} --crash-test segv --data-dir ${DIR} OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}${err}")
file(GLOB dumps ${DIR}/crashes/reports/*.dmp)
list(LENGTH dumps count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "${count} minidumps in ${DIR}/crashes/reports")
endif()
file(READ ${dumps} magic LIMIT 4 HEX)
if(NOT magic STREQUAL "4d444d50")
  message(FATAL_ERROR "${dumps} is no minidump")
endif()
file(SIZE ${dumps} size)
message("minidump file: ${size} bytes")
