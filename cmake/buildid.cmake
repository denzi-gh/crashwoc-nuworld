# cmake -DSRC=<source dir> -DOUT=<file.c> -DVERSION=<x.y.z> -DTAG=<tag> -P buildid.cmake
# Writes OUT only when the build ID changed.
function(nw_git dir out)
  execute_process(COMMAND git -C "${dir}" rev-parse --short=7 HEAD
    OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE failed ERROR_QUIET)
  if(failed OR hash STREQUAL "")
    set(${out} "unknown" PARENT_SCOPE)
    return()
  endif()
  execute_process(COMMAND git -C "${dir}" status --porcelain --ignore-submodules=dirty
    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT changes STREQUAL "")
    string(APPEND hash "-dirty")
  endif()
  set(${out} "${hash}" PARENT_SCOPE)
endfunction()

nw_git("${SRC}" commit)
nw_git("${SRC}/decomp" decomp)
set(id "${VERSION}")
if(NOT TAG STREQUAL "")
  string(APPEND id " ${TAG}")
endif()
string(APPEND id " ${commit}")

string(CONCAT text
  "/* Generated by cmake/buildid.cmake. */\n"
  "const char nw_build_version[] = \"${VERSION}\";\n"
  "const char nw_build_tag[] = \"${TAG}\";\n"
  "const char nw_build_commit[] = \"${commit}\";\n"
  "const char nw_build_decomp[] = \"${decomp}\";\n"
  "const char nw_build_id[] = \"${id}\";\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
