# Writes a C file holding one binary file as an array:
#   cmake -DIN=<file> -DOUT=<file.c> -DNAME=<symbol> -P embed.cmake
# defines `const unsigned char NAME[]` and `const size_t NAME_size`.
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){24})" "\\1\n    " bytes "${bytes}")
file(WRITE "${OUT}"
  "/* Generated by cmake/embed.cmake from ${IN}. */\n"
  "#include <stddef.h>\n\n"
  "const unsigned char ${NAME}[${size}] = {\n    ${bytes}\n};\n"
  "const size_t ${NAME}_size = ${size};\n")
