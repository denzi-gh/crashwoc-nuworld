# Writes a C file holding every PNG of a directory, by its name without .png:
#   cmake -DDIR=<dir> -DOUT=<file.c> -DNAME=<symbol> -P embed_dir.cmake
# defines `const struct nw_embed_file NAME[]` ({ name, data, size }) and `const size_t NAME_count`.
file(GLOB files RELATIVE "${DIR}" "${DIR}/*.png")
list(SORT files)
set(arrays "")
set(entries "")
set(count 0)
foreach(f IN LISTS files)
  file(READ "${DIR}/${f}" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x..,){24})" "\\1\n    " bytes "${bytes}")
  string(REGEX REPLACE "\\.png$" "" stem "${f}")
  string(APPEND arrays "static const unsigned char ${NAME}_${count}[${size}] = {\n    ${bytes}\n};\n")
  string(APPEND entries "    { \"${stem}\", ${NAME}_${count}, ${size} },\n")
  math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}"
  "/* Generated by cmake/embed_dir.cmake from ${DIR}. */\n"
  "#include <stddef.h>\n\n"
  "struct nw_embed_file {\n    const char *name;\n    const unsigned char *data;\n    size_t size;\n};\n\n"
  "${arrays}\n"
  "const struct nw_embed_file ${NAME}[] = {\n${entries}};\n"
  "const size_t ${NAME}_count = ${count};\n")
